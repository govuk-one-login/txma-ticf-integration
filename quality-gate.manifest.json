{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.19.0/schemas/schema.json",
  "services": [
    {
      "product": "Audit-Service",
      "component": "txma-ticf-integration",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": [
                "new feature"
              ]
            },
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/build-test-package.yaml"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit test coverage"
            },
            {
              "name": "code quality"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/sonarcloud.yaml"
        },
        {
          "phase": "pre-upload",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": [
                "new feature"
              ]
            },
            {
              "name": "code style and linting"
            },
            {
              "name": "canary"
            }
          ],
          "file": ".github/workflows/build-test-package.yaml"
        }
      ]
    }
  ]
}
