{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.11.0/schemas/schema.json",
  "services": [
    {
      "serviceTag": "data-dpt",
      "promotionType": "securePipelines",
      "checks": [
        {
          "checkTypes": ["unit", "code style and linting", "new feature"],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/build-test-package.yaml"
          }
        },
        {
          "checkTypes": [
            "unit test coverage",
            "code quality",
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/sonarcloud.yaml"
          }
        },
        {
          "checkTypes": [
            "unit",
            "code style and linting",
            "new feature",
            "canary"
          ],
          "phase": "pre-upload",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/build-test-package.yaml"
          }
        }
      ]
    }
  ]
}
